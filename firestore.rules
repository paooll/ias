rules_version = '2';

// MediCare Pro – Firestore Security Rules
// ---------------------------------------------------------------------------
// Principles:
//  * NOTHING is readable or writable by unauthenticated users.
//  * Patient records are fully CRUD-able by any signed-in staff member
//    (Bed Management page: admit, edit, move, discharge/delete).
//  * Users may create/update/delete their OWN notes and their OWN staff profile.
//  * Feedback reviews are readable/submittable by all signed-in staff.
//  * Reference data (lab_reports) is written ONLY via the Admin SDK (seed).
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Staff profiles (created by seed script / /api/login via Admin SDK) ----
    // Clients can read/update only their own profile document (doc id == auth uid).
    match /staff/{uid} {
      allow read:   if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- Patient records ----
    // Any signed-in staff can read and write patients (CRUD for the
    // Bed Management page).
    match /patients/{patientId} {
      allow read, create, update, delete: if signedIn();
    }

    // ---- Clinical notes (stored-XSS lab) ----
    // Authenticated staff can read all notes, but only create/update/delete
    // notes they authored themselves.
    match /notes/{noteId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // ---- Patient feedback (satisfaction surveys) ----
    // Signed-in staff can read all feedback and submit new reviews.
    // Authors can update/delete only their own reviews.
    match /feedback/{feedbackId} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // ---- Lab reports ----
    // Read-only for authenticated staff, written only via Admin SDK (seed).
    match /lab_reports/{reportId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ---- Activity feed ----
    // Authenticated staff can read; activity entries are created by the app
    // (signed-in users) but never edited or deleted from the browser.
    match /activity/{activityId} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update: if false;
      allow delete: if false;
    }

    // ---- Uploaded documents (Documents page) ----
    // Signed-in staff can read all documents; they may upload new ones and
    // delete only documents they uploaded themselves.
    match /documents/{docId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uploadedBy == request.auth.uid;
    }
  }
}
