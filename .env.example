# =============================================================================
# MediCare Pro - Firebase environment variables
# Copy this file to `.env` for local development. Add the same values as
# runtime environment variables in Render before deploying.
# =============================================================================

# Public Firebase web configuration (returned to the browser by the app).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef...

# Server-only Firebase Admin credential. Keep it out of Git. In Render, add
# it as a secret runtime environment variable, on one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Local alternative to FIREBASE_SERVICE_ACCOUNT:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
