# =============================================================================
# MediCare Pro – Firebase environment variables
# Copy this file to `.env` (local seeding only) and set the same values in the
# Vercel dashboard (Project Settings → Environment Variables).
#
# The WEB config values are public by design (Firebase web apps expose them) —
# security comes from the Firestore rules + Firebase Auth.
# The SERVICE ACCOUNT JSON is a SECRET. Never commit it to the repository.
# =============================================================================

# --- Firebase Web config (public; used by the browser via /api/firebase-config) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef...

# --- Firebase Admin SDK (SECRET; used by /api/login and the seed script) ---
# Paste the ENTIRE contents of the downloaded service-account JSON as one value.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# --- Local seed script alternative ---
# Instead of FIREBASE_SERVICE_ACCOUNT, you may point to the downloaded JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json



<script type="module">
  // Import the functions you need from the SDKs you need
  import { initializeApp } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-app.js";
  // TODO: Add SDKs for Firebase products that you want to use
  // https://firebase.google.com/docs/web/setup#available-libraries

  // Your web app's Firebase configuration
  const firebaseConfig = {
    apiKey: "AIzaSyCo7sDN7QYRb1SXtN8rPb3MCwPwo5ZgShA",
    authDomain: "medicare-pro-dd077.firebaseapp.com",
    projectId: "medicare-pro-dd077",
    storageBucket: "medicare-pro-dd077.firebasestorage.app",
    messagingSenderId: "205922446355",
    appId: "1:205922446355:web:147740d7651494f0f163e6"
  };

  // Initialize Firebase
  const app = initializeApp(firebaseConfig);
</script>